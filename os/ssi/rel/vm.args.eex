## ElixirSSI BEAM arguments. The BEAM is PID 1.
## Distribution is started by SSI.Cluster.Distribution once networking is up;
## node-to-node lookup uses SSI.Cluster.Epmd, so no epmd daemon exists.
## Distribution runs over TLS 1.3 with mutual certificate verification
## (SSI.Cluster.TLS); the cookie is checked on top.
-proto_dist inet_tls
-ssl_dist_optfile /ssi/ssl_dist.conf
-start_epmd false
-epmd_module Elixir.SSI.Cluster.Epmd
-kernel inet_dist_listen_min 4370 inet_dist_listen_max 4370
-kernel net_ticktime 8
+sbwt none
+sbwtdcpu none
+sbwtdio none
+A 16
+P 4194304
+Q 1048576
+zdbbl 32768
-env ERL_CRASH_DUMP /run/erl_crash.dump
