# ElixirSSI kernel fragment, merged over the Raspberry Pi bcm2712_defconfig.
#
# Linux is the hardware abstraction layer only: it owns MMU, interrupts, the
# scheduler that multiplexes BEAM scheduler threads onto cores, and device
# drivers. There is no Linux userland. PID 1 is the BEAM, and everything a
# user or program sees is implemented in Elixir.
CONFIG_LOCALVERSION="-elixirssi"
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# One image boots both a real Compute Module 5 and the QEMU/KVM `virt`
# development machine, so the guest you test is the kernel you ship.
CONFIG_ARM_GIC_V3=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_RTC_DRV_PL031=y
# A virtio keyboard lets automated tests type on the VT shell (tty1).
CONFIG_VIRTIO_INPUT=y

# CM5 boot path built in so the system needs no module loading to reach the
# network: PCIe root complex -> RP1 south bridge -> Cadence GEM Ethernet, and
# the eMMC/SD controller holding the data partition.
CONFIG_PCIE_BRCMSTB=y
CONFIG_MFD_RP1=y
CONFIG_MACB=y
CONFIG_BROADCOM_PHY=y
CONFIG_MMC_SDHCI_BRCMSTB=y
CONFIG_MMC_SDHCI_OF_DWCMSHC=y
CONFIG_SENSORS_RASPBERRYPI_HWMON=y
CONFIG_NLS_ISO8859_1=y

# Compressed initramfs carrying ERTS, Elixir and the OS.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_ZSTD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y

# Modules ship uncompressed inside the (compressed) initramfs and are loaded by
# the Elixir device manager with finit_module(2).
# CONFIG_MODULE_COMPRESS is not set
