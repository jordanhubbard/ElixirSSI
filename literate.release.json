{
  "schema": "literate-ai/release-policy@2",
  "version_scheme": "semver",
  "version_authority": {
    "path": "literate.project.json",
    "format": "json-pointer",
    "selectors": [
      "/version"
    ]
  },
  "version_mirrors": [
    {
      "path": "os/ssi/version.json",
      "format": "json-pointer",
      "selectors": [
        "/version"
      ]
    }
  ],
  "contributions": {
    "current_milestone": "{version}"
  },
  "allowed_transitions": [
    "patch",
    "minor",
    "major",
    "prerelease",
    "explicit"
  ],
  "gate": {
    "argv": [
      "make",
      "verify"
    ],
    "timeout_seconds": 86400
  },
  "changelog": {
    "path": "CHANGELOG.md",
    "unreleased_heading": "## Unreleased"
  },
  "tag": {
    "prefix": "v",
    "signed": false
  },
  "remote": "origin",
  "provider": {
    "kind": "github",
    "repository": "jordanhubbard/ElixirSSI"
  },
  "documentation_authority": [
    "docs/architecture/design-traceability.md"
  ],
  "artifact_gate": {
    "argv": [
      "make",
      "release-assets-check"
    ],
    "timeout_seconds": 86400,
    "manifest": "_build/release/files.json",
    "required_roles": [
      "image",
      "emulator",
      "development",
      "command",
      "source",
      "emulator-source",
      "kernel-source",
      "installer",
      "launcher",
      "installation",
      "checksums",
      "installation-check"
    ]
  }
}
